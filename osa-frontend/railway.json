{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm ci && npm install serve && npm run build:prod"
  },
  "deploy": {
    "runtime": "V2",
    "numReplicas": 1,
    "sleepApplication": false,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "startCommand": "npx serve dist/osa-frontend -s -l $PORT -n",
    "healthcheckPath": "/",
    "healthcheckTimeout": 100,
    "cronSchedule": ""
  }
}